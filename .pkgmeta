manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - images
  - docs
  - .ignored
  - .github
  - .gitignore
  - .claude
  - .luacheckrc
  - .luarc.json
  - .styluaignore
  - stylua.toml
  - scripts
  - Makefile
  - README.md
  - CURSEFORGE.md
  - CLAUDE.md
  - CONTRIBUTING.md
  - types.lua
  - cliff.toml
